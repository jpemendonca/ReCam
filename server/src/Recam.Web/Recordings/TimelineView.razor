@using System.Net
@using System.Globalization
@implements IDisposable
@inject IStringLocalizer<Strings> L
@inject TimelineController Timeline
@inject BrightenController Brighten
@inject CameraListController Cameras
@inject IVideoClock VideoClock
@inject IPeopleOverlay PeopleOverlay
@inject ITimelineGestures Gestures
@inject TimeProvider Time

@if (Timeline.Failed)
{
    <p class="error" role="alert">@L["TimelineLoadFailed"]</p>
    <button @onclick="() => Timeline.LoadAsync(CameraId)">@L["OfflineRetry"]</button>
}
@* The days arrive before one is chosen; the bar needs the chosen day. *@
else if ((Timeline.Loading && Timeline.Days.Count == 0) || (Timeline.Days.Count > 0 && Timeline.SelectedDay is null))
{
    <div class="loading" aria-hidden="true"></div>
}
else if (Timeline.Days.Count == 0)
{
    <p class="note">@L["TimelineEmpty"]</p>
}
else
{
    <div class="days">
        @foreach (var day in Timeline.Days)
        {
            <button class="@(day == Timeline.SelectedDay ? "day selected" : "day")" @onclick="() => Timeline.SelectDayAsync(day)">
                @day.ToString("M", CultureInfo.CurrentCulture)
            </button>
        }
    </div>

    @if (Timeline.Quota is { } quota)
    {
        <p class="space">@SpaceText(quota)</p>
    }
    <p class="note">@L["TimelineTapToPlay"]</p>

    <div class="zooms">
        @foreach (var zoom in TimelineZoom.All)
        {
            <button class="@(zoom == Window.Zoom ? "zoom selected" : "zoom")" @onclick="() => ZoomTo(zoom)">@ZoomLabel(zoom)</button>
        }
        <span class="spacer"></span>
        <a class="button secondary go-live" href="cameras/@CameraId">@L["TimelineGoLive"]</a>
    </div>
    <p class="center-time" aria-live="polite">@CenterText</p>

    @* The day's events above the recordings: yellow with a person when the detect service saw
       one, grey for motion alone; a tap plays the event. An SVG of its own, not stretched like the
       bar, so the icons keep their shape; positions are percentages because the CSP refuses inline
       styles. A circle under each event keeps a short one visible and tappable. *@
    <svg class="events" role="list" aria-label="@L["TimelineEventsLabel"]">
        @foreach (var mark in Timeline.ShownMotion.Where(mark => mark.End > Window.Start && mark.Start < Window.End))
        {
            var shown = mark;
            var middle = mark.Start + (mark.End - mark.Start) / 2;
            <g class="@(mark.Person == true ? "event person" : "event")" role="listitem" @onclick="() => Timeline.PlayMark(shown)">
                <title>@EventTitle(mark)</title>
                <rect class="pill" x="@Percent(mark.Start)" y="3" width="@PercentWidth(mark.Start, mark.End)" height="18" rx="9" />
                <circle cx="@Percent(middle)" cy="12" r="10" />
                @if (mark.Person == true)
                {
                    <svg class="icon" x="@Percent(middle)" y="12" width="14" height="14" overflow="visible" aria-hidden="true">
                        <g transform="translate(-7 -7)">
                            <circle cx="7" cy="4" r="3" />
                            <path d="M1.5 14a5.5 5 0 0 1 11 0z" />
                        </g>
                    </svg>
                }
            </g>
        }
    </svg>

    @* The line in the middle stays; the recordings run under it as the video plays, and the
       person drags them to go back or ahead. *@
    <svg class="hours" @ref="bar" viewBox="0 0 @Width 36" preserveAspectRatio="none" role="img" aria-label="@L["TimelineBarLabel"]">
        <rect class="track" x="0" y="0" width="@Width" height="36" rx="6" />
        @foreach (var (start, end, playing) in RecordedStretches())
        {
            <rect class="@(playing ? "recorded playing" : "recorded")"
                  x="@X(start)" y="0" width="@SpanWidth(start, end, 1)" height="36" />
        }
        <line class="playhead" x1="@F(Width / 2)" x2="@F(Width / 2)" y1="0" y2="36" />
    </svg>
    @* An SVG of its own, not stretched like the bar, so the labels keep their shape; positions
       are attributes because the CSP refuses inline styles. *@
    <svg class="ticks" aria-hidden="true">@((MarkupString)TickLabels())</svg>

    <div class="motion-row">
        <button class="secondary previous-motion" @onclick="Timeline.PlayPreviousMotion" disabled="@(Timeline.ShownMotion.Count == 0)">@L["MotionPrevious"]</button>
        <button class="secondary next-motion" @onclick="Timeline.PlayNextMotion" disabled="@(Timeline.ShownMotion.Count == 0)">@L["MotionNext"]</button>
        <label>
            <input class="only-motion" type="checkbox" @bind="Timeline.OnlyMotion" />
            @L["MotionOnly"]
        </label>
        @if (Timeline.PeopleAnalyzed)
        {
            <label>
                <input class="only-people" type="checkbox" @bind="Timeline.OnlyPeople" />
                @L["PeopleOnly"]
            </label>
        }
        <label>
            @L["MotionSensitivity"]
            <select class="sensitivity" value="@Timeline.Sensitivity" @onchange="e => Timeline.SetSensitivityAsync(e.Value?.ToString() ?? string.Empty)">
                <option value="low">@L["MotionLow"]</option>
                <option value="medium">@L["MotionMedium"]</option>
                <option value="high">@L["MotionHigh"]</option>
            </select>
        </label>
    </div>
    <p class="motion-summary">@MotionSummary</p>
    @if (Timeline.SensitivityFailed)
    {
        <p class="error" role="alert">@L["MotionSensitivityFailed"]</p>
    }

    @if (Timeline.Source is { } source)
    {
        <p class="playing-from">@L["TimelinePlaying", Timeline.PlayingFrom!.Value.ToString("t", CultureInfo.CurrentCulture)]</p>
        @* One <video> for every file: replacing it, or letting it shrink while the next file loads,
           made the page jump to the top on "Next motion". *@
        <div class="player" @ref="player">
            @* The page's own full screen button takes the boxes along; the video's own would not. *@
            <video @ref="video" src="@source" controls controlslist="nofullscreen" autoplay playsinline @onended="Timeline.PlayNext"></video>
            @* Filled by people.js as the video plays. *@
            <svg class="people-boxes" @ref="boxes" aria-hidden="true"></svg>
            <span class="video-clock" @ref="clock"></span>
        </div>
        <div class="brighten-row">
            <BrightenControls Controller="Brighten" />
            <button class="secondary full-screen" @onclick="() => PeopleOverlay.FullScreenAsync(player)">@L["PlayerFullScreen"]</button>
            @if (Timeline.PlayingPeople is not null)
            {
                <label>
                    <input class="show-people" type="checkbox" checked="@Timeline.ShowPeople"
                           @onchange="e => Timeline.SetShowPeopleAsync(e.Value is true)" />
                    @L["PeopleShow"]
                </label>
            }
        </div>
    }
}

@code {
    private const double Width = 1000;

    /// <summary>A recording this close to now is still being written, so its stretch grows to now.</summary>
    public static readonly TimeSpan StillRecording = TimeSpan.FromMinutes(2);

    /// <summary>How often a stretch still being recorded grows on screen.</summary>
    public static readonly TimeSpan GrowEvery = TimeSpan.FromSeconds(5);

    private TimelineWindow? window;
    private bool windowHasData;
    private DateTime? windowFollows;
    private TimelineWindow? dragStart;
    private ElementReference bar;
    private bool barAttached;
    private readonly CancellationTokenSource leaving = new();

    // The window opens on what plays, or else on the day's latest recording, and moves to wherever
    // playback starts (a tap, the next motion, a drop).
    private TimelineWindow Window
    {
        get
        {
            var day = Timeline.SelectedDay!.Value.ToDateTime(TimeOnly.MinValue);
            var hasData = Timeline.Timeline.Count > 0;
            var playing = Timeline.PlayingFrom;
            var zoom = window?.Zoom ?? TimelineZoom.HalfHour;
            if (window is null || window.Day != day || (hasData && !windowHasData))
            {
                window = TimelineWindow.Around(day, zoom, playing ?? LatestRecorded() ?? day);
                windowHasData = hasData;
                windowFollows = playing;
            }
            else if (playing is { } from && from != windowFollows && dragStart is null)
            {
                window = TimelineWindow.Around(day, zoom, from);
                windowFollows = from;
            }

            return window;
        }
    }

    private DateTime Now => Timeline.Wall(Time.GetUtcNow());

    // The newest stretch grows to now while the camera records into it.
    private DateTime? GrowingUntil
    {
        get
        {
            if (Timeline.Timeline.Count == 0
                || Cameras.Camera(CameraId)?.ShownRecordingState != CameraRecordingState.Recording)
            {
                return null;
            }

            var now = Now;
            var last = Timeline.Timeline[^1];
            return now > last.End && now - last.End < StillRecording ? now : null;
        }
    }

    private DateTime? LatestRecorded() => GrowingUntil ?? (Timeline.Timeline.Count > 0 ? Timeline.Timeline[^1].End : null);

    private IEnumerable<(DateTime Start, DateTime End, bool Playing)> RecordedStretches()
    {
        var growing = GrowingUntil;
        for (var index = 0; index < Timeline.Timeline.Count; index++)
        {
            var segment = Timeline.Timeline[index];
            var end = growing is { } until && index == Timeline.Timeline.Count - 1 ? until : segment.End;
            if (end > Window.Start && segment.Start < Window.End)
            {
                yield return (segment.Start, end, segment == Timeline.Playing);
            }
        }
    }

    private Guid loaded;
    private ElementReference video;
    private ElementReference player;
    private ElementReference boxes;
    private PersonTrack? boxesFollow;
    private ElementReference clock;
    private TimelineSegment? clockFollows;

    /// <summary>The camera whose recordings show; changing it loads the other camera.</summary>
    [Parameter, EditorRequired]
    public Guid CameraId { get; set; }

    protected override void OnInitialized()
    {
        Timeline.Changed += OnChanged;
        Brighten.Changed += OnChanged;
        Cameras.Changed += OnChanged;
        VideoClock.HeadMoved += OnHeadMoved;
        Gestures.Tapped += OnTapped;
        Gestures.Dragging += OnDragging;
        Gestures.Dropped += OnDropped;
        _ = GrowAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (CameraId == loaded)
        {
            return;
        }

        loaded = CameraId;
        await Brighten.LoadAsync(CameraId);
        await Timeline.LoadAsync(CameraId);
    }

    public void Dispose()
    {
        Timeline.Changed -= OnChanged;
        Brighten.Changed -= OnChanged;
        Cameras.Changed -= OnChanged;
        VideoClock.HeadMoved -= OnHeadMoved;
        Gestures.Tapped -= OnTapped;
        Gestures.Dragging -= OnDragging;
        Gestures.Dropped -= OnDropped;
        leaving.Cancel();
        leaving.Dispose();
    }

    // Redraws now and then, so a stretch still being recorded grows to now.
    private async Task GrowAsync()
    {
        var token = leaving.Token;
        try
        {
            using var timer = new PeriodicTimer(GrowEvery, Time);
            while (await timer.WaitForNextTickAsync(token))
            {
                if (Timeline.SelectedDay is not null && GrowingUntil is not null)
                {
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
            // The page closed.
        }
    }

    // The filter goes on again after every render: the file, and the <video>, may have changed.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Timeline.Source is not null)
        {
            await Brighten.ApplyAsync(video);
        }

        // The boxes follow the file playing, when it has people and they are wanted.
        var track = Timeline.ShowPeople ? Timeline.PlayingPeople : null;
        if (track != boxesFollow)
        {
            boxesFollow = track;
            if (track is null)
            {
                await PeopleOverlay.StopAsync();
            }
            else
            {
                await PeopleOverlay.FollowAsync(video, boxes, track);
            }
        }

        if (!barAttached && window is not null)
        {
            barAttached = true;
            await Gestures.AttachAsync(bar);
        }

        // The clock restarts from each file's start, so it keeps going when the next file plays.
        if (Timeline.Playing is not { } playing)
        {
            if (clockFollows is not null)
            {
                clockFollows = null;
                await VideoClock.StopAsync();
            }
        }
        else if (playing != clockFollows)
        {
            clockFollows = playing;
            await VideoClock.FollowAsync(video, clock, playing.Start);
        }
    }

    private string MotionSummary => Timeline.Motion.Count == 0 ? L["MotionNone"]
        : Timeline.PeopleAnalyzed ? L["MotionSummaryPeople", Timeline.Motion.Count, Timeline.People.Count]
        : L["MotionSummary", Timeline.Motion.Count];

    private string EventTitle(MotionMark mark) =>
        L[mark.Person == true ? "EventPerson" : "EventMotion", mark.Start.ToString("T", CultureInfo.CurrentCulture)];

    // Where a time falls on the events row, as a percentage of its width, kept on the row.
    private string Percent(DateTime time) => $"{F(Math.Clamp(Window.FractionOf(time), 0, 1) * 100)}%";

    private string PercentWidth(DateTime start, DateTime end) =>
        $"{F((Math.Clamp(Window.FractionOf(end), 0, 1) - Math.Clamp(Window.FractionOf(start), 0, 1)) * 100)}%";

    private string X(DateTime time) => F(Math.Clamp(Window.FractionOf(time), 0, 1) * Width);

    // Clipped to the window; short stretches and motion keep a visible width.
    private string SpanWidth(DateTime start, DateTime end, double minimum)
    {
        var left = Math.Clamp(Window.FractionOf(start), 0, 1);
        var right = Math.Clamp(Window.FractionOf(end), 0, 1);
        return F(Math.Max((right - left) * Width, minimum));
    }

    private static string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    // Razor keeps <text> for itself, so the SVG labels are written as markup.
    private string TickLabels() => string.Concat(Window.Ticks.Select(tick =>
        $"<text x=\"{F(Window.FractionOf(tick) * 100)}%\" y=\"12\" text-anchor=\"middle\">{WebUtility.HtmlEncode(Clock(tick))}</text>"));

    private string Clock(DateTime time) =>
        time.ToString(Window.Zoom == TimelineZoom.Minute ? "T" : "t", CultureInfo.CurrentCulture);

    private string ZoomLabel(TimelineZoom zoom) => L[zoom == TimelineZoom.Minute ? "TimelineZoomMinute"
        : zoom == TimelineZoom.FiveMinutes ? "TimelineZoomFiveMinutes"
        : zoom == TimelineZoom.HalfHour ? "TimelineZoomHalfHour"
        : zoom == TimelineZoom.Hour ? "TimelineZoomHour"
        : "TimelineZoomDay"];

    // The space is shared, so the hours it holds shrink with every camera that records.
    private string SpaceText(QuotaInfo quota)
    {
        var recording = Cameras.Cameras.Count(camera => camera.Recording);
        return L["TimelineSpace",
            (quota.UsedBytes / 1024.0 / 1024 / 1024).ToString("0.#", CultureInfo.CurrentCulture),
            (quota.QuotaMb / 1024.0).ToString("0.#", CultureInfo.CurrentCulture),
            QuotaController.HoursFor(quota.QuotaMb, recording).ToString("0.#", CultureInfo.CurrentCulture)];
    }

    // The date and the moment under the middle line; seconds matter except on the whole day.
    private string CenterText =>
        $"{Window.Center.ToString("d", CultureInfo.CurrentCulture)} {Window.Center.ToString(Window.Zoom == TimelineZoom.Day ? "t" : "T", CultureInfo.CurrentCulture)}";

    private void ZoomTo(TimelineZoom zoom) => window = Window.ZoomTo(zoom);

    private void OnChanged() => InvokeAsync(StateHasChanged);

    // The recordings run under the middle line as the video plays; not while the person drags.
    private void OnHeadMoved(DateTime head) => InvokeAsync(() =>
    {
        if (window is { } shown && dragStart is null)
        {
            window = TimelineWindow.Around(shown.Day, shown.Zoom, head);
            StateHasChanged();
        }
    });

    // A tap plays from the moment under the finger.
    private void OnTapped(double fraction) => InvokeAsync(() =>
    {
        if (window is not null)
        {
            Timeline.PlayAt(Window.TimeAt(fraction));
        }
    });

    private void OnDragging(double fraction) => InvokeAsync(() =>
    {
        if (window is null)
        {
            return;
        }

        dragStart ??= Window;
        window = dragStart.PanBy(fraction);
        StateHasChanged();
    });

    // Letting go plays from the moment under the middle line.
    private void OnDropped(double fraction) => InvokeAsync(() =>
    {
        if (window is null)
        {
            return;
        }

        window = (dragStart ?? Window).PanBy(fraction);
        dragStart = null;
        Timeline.PlayAt(window.Center);
        StateHasChanged();
    });
}
