@using System.Globalization
@implements IDisposable
@inject IStringLocalizer<Strings> L
@inject CameraListController Cameras

<p class="scope">@L["SettingsSpaceScope"]</p>
@switch (Quota.State)
{
    case QuotaState.Loading:
        <div class="loading" aria-hidden="true"></div>
        break;

    case QuotaState.Failed:
        <p class="error" role="alert">@L["RecordingsLoadFailed"]</p>
        <button @onclick="Quota.LoadAsync">@L["OfflineRetry"]</button>
        break;

    default:
        <p class="note">@L["RecordingsInUse", Gigabytes(Quota.Quota!.UsedBytes / 1024.0 / 1024.0), Gigabytes(Quota.Quota.QuotaMb)]</p>
        <label for="space">@L["RecordingsSpace", Gigabytes(Quota.SelectedMegabytes)]</label>
        <input id="space" type="range" min="@QuotaController.MinimumMegabytes" max="@Quota.MaxMegabytes" step="100"
               value="@Quota.SelectedMegabytes" @oninput="OnInput" />
        <p class="hours">@HoursText()</p>
        <p class="note">@L["RecordingsHowItWorks"]</p>
        break;
}

@code {
    /// <summary>The page's quota: the page loads it and owns the buttons that save it.</summary>
    [Parameter, EditorRequired]
    public QuotaController Quota { get; set; } = null!;

    protected override void OnInitialized()
    {
        Quota.Changed += OnChanged;
        Cameras.Changed += OnChanged;
    }

    public void Dispose()
    {
        Quota.Changed -= OnChanged;
        Cameras.Changed -= OnChanged;
    }

    // The space is shared, so the hours that fit shrink with every camera that records.
    private string HoursText()
    {
        var recording = Cameras.Cameras.Count(camera => camera.Recording);
        var hours = QuotaController.HoursFor(Quota.SelectedMegabytes, recording).ToString("0.#", CultureInfo.CurrentCulture);
        return recording switch
        {
            0 => L["RecordingsHours", hours],
            1 => L["RecordingsHoursOneCamera", hours],
            _ => L["RecordingsHoursCameras", hours, recording],
        };
    }

    private static string Gigabytes(double megabytes) => (megabytes / 1024).ToString("0.0", CultureInfo.CurrentCulture);

    private void OnInput(ChangeEventArgs change)
    {
        if (int.TryParse(change.Value?.ToString(), CultureInfo.InvariantCulture, out var megabytes))
        {
            Quota.Select(megabytes);
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);
}
