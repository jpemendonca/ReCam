@page "/settings"
@implements IDisposable
@inject IStringLocalizer<Strings> L
@inject QuotaController Quota

<PageTitle>@L["SettingsTitle"]</PageTitle>

<div class="bar">
    <h1>@L["SettingsTitle"]</h1>
</div>

<section class="card">
    <h2>@L["RecordingsSpaceOpen"]</h2>
    <SpaceEditor Quota="Quota" />
    @if (Quota.State == QuotaState.Ready)
    {
        <button @onclick="Quota.SaveAsync" disabled="@Quota.Saving">@L["RecordingsSave"]</button>
        @if (Quota.Saved == true)
        {
            <p class="ok" role="status">@L["RecordingsSaved"]</p>
        }
        else if (Quota.Saved == false)
        {
            <p class="error" role="alert">@L["RecordingsSaveFailed"]</p>
        }
    }
</section>

<section class="card">
    <LanguagePicker />
</section>

<section class="card">
    <VersionInfo />
</section>

@code {
    protected override Task OnInitializedAsync()
    {
        Quota.Changed += OnChanged;
        return Quota.LoadAsync();
    }

    public void Dispose() => Quota.Changed -= OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);
}
