@page "/cameras/{CameraId:guid}/recordings"
@implements IDisposable
@inject IStringLocalizer<Strings> L
@inject CameraListController Cameras

<PageTitle>@Title</PageTitle>

<div class="bar">
    <a href="">← @L["LiveBack"]</a>
    <h1>@Title</h1>
</div>

<TimelineView CameraId="CameraId" />

@code {
    [Parameter]
    public Guid CameraId { get; set; }

    private string Title => L["TimelineTitle", Cameras.Camera(CameraId)?.Name ?? string.Empty];

    protected override void OnInitialized()
    {
        Cameras.Changed += OnChanged;
        _ = Cameras.StartAsync(CancellationToken.None);
    }

    public void Dispose() => Cameras.Changed -= OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);
}
