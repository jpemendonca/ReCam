@page "/"
@implements IDisposable
@inject IStringLocalizer<Strings> L
@inject StartController Start
@inject CameraListController Cameras
@inject NavigationManager Navigation

<PageTitle>@L["AppTitle"]</PageTitle>

@switch (Start.State)
{
    case StartState.Loading:
        <div class="loading" aria-hidden="true"></div>
        break;

    case StartState.NeedsCode:
        <section class="card">
            <h1>@L["CodeTitle"]</h1>
            <p>@L["CodeIntro"]</p>
            <form @onsubmit="SubmitAsync">
                <label for="code">@L["CodeLabel"]</label>
                <input id="code" class="code" @bind="code" autocomplete="off" autocapitalize="characters"
                       spellcheck="false" maxlength="11" placeholder="ABCD-EFGH" />
                <label class="check">
                    <input type="checkbox" @bind="remember" />
                    @L["CodeRemember"]
                </label>
                @if (Start.CodeError is { } error)
                {
                    <p class="error" role="alert">@ErrorText(error)</p>
                }
                <button type="submit" disabled="@Start.Busy">@L["CodeSubmit"]</button>
            </form>
        </section>
        break;

    case StartState.ServerTaken:
        <section class="card">
            <h1>@L["ServerTakenTitle"]</h1>
            <p>@L["ServerTakenText"]</p>
            <ConnectPanel Connected="LoadAsync" />
            <p>@L["ServerTakenInvite"]</p>
        </section>
        break;

    case StartState.Monitor:
        <CameraList SignedOut="LoadAsync">
            <HeaderActions>
                <a class="button" href="add-camera">@L["AddCameraButton"]</a>
            </HeaderActions>
            <Empty>
                <section class="card wide">
                    <h2>@L["FirstCameraTitle"]</h2>
                    <AddDevicePanel Kind="DeviceKind.Camera" Guided="true" Paired="FirstCameraPairedAsync" />
                </section>
            </Empty>
        </CameraList>
        break;

    case StartState.Offline:
        <section class="card">
            <h1>@L["OfflineTitle"]</h1>
            <button @onclick="LoadAsync" disabled="@Start.Busy">@L["OfflineRetry"]</button>
        </section>
        break;
}

@code {
    private string code = string.Empty;
    private bool remember = true;

    protected override Task OnInitializedAsync()
    {
        Start.Changed += OnChanged;
        return Start.EnsureLoadedAsync(CancellationToken.None);
    }

    public void Dispose() => Start.Changed -= OnChanged;

    private Task LoadAsync() => Start.LoadAsync(CancellationToken.None);

    private Task SubmitAsync() => Start.SubmitCodeAsync(code, remember, CancellationToken.None);

    private void OnChanged() => InvokeAsync(StateHasChanged);

    // After the first camera, the person chooses the recording space; then its live video
    // opens by itself, the moment the person sees it works.
    private async Task FirstCameraPairedAsync()
    {
        await Cameras.RefreshAsync(CancellationToken.None);
        if (Cameras.Cameras is [var first])
        {
            Navigation.NavigateTo($"first-space/{first.Id}");
        }
    }

    private string ErrorText(FirstOpenOutcome error) => error switch
    {
        FirstOpenOutcome.TooManyAttempts => L["CodeTooMany"],
        _ => L["CodeWrong"],
    };
}
