@page "/recordings"
@implements IDisposable
@inject IStringLocalizer<Strings> L
@inject CameraListController Cameras

<PageTitle>@L["RecordingsTitle"]</PageTitle>

<div class="bar">
    <h1>@L["RecordingsTitle"]</h1>
    @if (Selected is { } shown)
    {
        <select class="camera-picker" aria-label="@L["RecordingsChooseCamera"]" value="@shown.Id" @onchange="Choose">
            @foreach (var camera in Cameras.Cameras)
            {
                <option value="@camera.Id">@(camera.Recording ? $"{camera.Name} · {L["CameraRecording"]}" : camera.Name)</option>
            }
        </select>
    }
</div>

@if (Cameras.State == CameraListState.Loading)
{
    <div class="loading" aria-hidden="true"></div>
}
else if (Selected is { } camera)
{
    <TimelineView @key="camera.Id" CameraId="camera.Id" />
}
else
{
    <p class="note">@L["RecordingsNoCameras"]</p>
}

@code {
    private Guid? chosen;

    // A recording camera first: it is the one with something to see.
    private CameraInfo? Selected =>
        Cameras.Cameras.FirstOrDefault(camera => camera.Id == chosen)
        ?? Cameras.Cameras.FirstOrDefault(camera => camera.Recording)
        ?? Cameras.Cameras.FirstOrDefault();

    protected override void OnInitialized() => Cameras.Changed += OnChanged;

    public void Dispose() => Cameras.Changed -= OnChanged;

    private void Choose(ChangeEventArgs change)
    {
        if (Guid.TryParse(change.Value?.ToString(), out var id))
        {
            chosen = id;
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);
}
