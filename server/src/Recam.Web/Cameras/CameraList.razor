@implements IDisposable
@inject IStringLocalizer<Strings> L
@inject CameraListController Cameras
@inject NavigationManager Navigation

<div class="head">
    <h1>@L["CamerasTitle"]</h1>
    <span class="hub @(Cameras.Connected ? "on" : "off")">
        @(Cameras.Connected ? L["HubConnected"] : L["HubReconnecting"])
    </span>
    <span class="spacer"></span>
    @HeaderActions
</div>

@switch (Cameras.State)
{
    case CameraListState.Loading:
        <div class="loading" aria-hidden="true"></div>
        break;

    case CameraListState.Failed:
        <p class="note">@L["CamerasFailed"]</p>
        <button @onclick="RetryAsync">@L["OfflineRetry"]</button>
        break;

    case CameraListState.Loaded when Cameras.Cameras.Count == 0:
        <p class="note">@L["CamerasEmpty"]</p>
        @Empty
        break;

    case CameraListState.Loaded:
        <ul class="cameras">
            @foreach (var camera in Cameras.Cameras)
            {
                var shown = camera;
                @* The whole card opens the live video; its buttons and links do their own thing. *@
                <li class="camera @(camera.Online ? string.Empty : "offline")" @onclick="() => Open(shown)">
                    <a class="open" href="cameras/@camera.Id" @onclick:stopPropagation="true">
                        <span class="dot @(camera.Publishing ? "live" : "off")"
                              title="@(camera.Publishing ? L["CameraStreaming"] : L["CameraNoPicture"])"></span>
                        <span class="name">@camera.Name</span>
                        @if (camera.TorchOn)
                        {
                            <span class="torch" title="@L["CameraTorchOn"]" aria-label="@L["CameraTorchOn"]">🔦</span>
                        }
                        @if (camera.Recording)
                        {
                            <span class="badge" title="@L["CameraRecording"]"><span class="rec" aria-hidden="true"></span>@L["CameraRecording"]</span>
                        }
                    </a>
                    <p class="status">@Status(camera)</p>
                    <div class="actions" @onclick:stopPropagation="true">
                        <RecordingToggle Camera="camera" />
                        <a class="link" href="cameras/@camera.Id/recordings">@L["RecordingsOpen"]</a>
                        <button class="secondary preview-toggle" @onclick="() => TogglePreview(shown.Id)">
                            @(previews.Contains(camera.Id) ? L["PreviewHide"] : L["PreviewShow"])
                        </button>
                    </div>
                    @if (previews.Contains(camera.Id))
                    {
                        <div @onclick:stopPropagation="true">
                            <CameraPreview CameraId="camera.Id" CloseAfter="PreviewCloseAfter" TimedOut="() => ClosePreview(shown.Id)" />
                        </div>
                    }
                </li>
            }
        </ul>
        break;
}

@code {
    /// <summary>Buttons at the right of the title, such as Sign out.</summary>
    [Parameter]
    public RenderFragment? HeaderActions { get; set; }

    /// <summary>What to offer when there is no camera yet.</summary>
    [Parameter]
    public RenderFragment? Empty { get; set; }

    [Parameter]
    public EventCallback SignedOut { get; set; }

    /// <summary>How long a card's live picture stays open. Shorter in tests.</summary>
    [Parameter]
    public TimeSpan PreviewCloseAfter { get; set; } = CameraPreview.DefaultCloseAfter;

    // Closed by default; leaving the page disposes the previews, which stop watching.
    private readonly HashSet<Guid> previews = [];

    protected override async Task OnInitializedAsync()
    {
        Cameras.Changed += OnChanged;
        await Cameras.StartAsync(CancellationToken.None);
        await ReportSignedOutAsync();
    }

    public void Dispose() => Cameras.Changed -= OnChanged;

    private async Task RetryAsync() => await Cameras.RetryAsync(CancellationToken.None);

    private void Open(CameraInfo camera) => Navigation.NavigateTo($"cameras/{camera.Id}");

    private void TogglePreview(Guid cameraId)
    {
        if (!previews.Remove(cameraId))
        {
            previews.Add(cameraId);
        }
    }

    private void ClosePreview(Guid cameraId) => previews.Remove(cameraId);

    private void OnChanged() => InvokeAsync(async () =>
    {
        StateHasChanged();
        await ReportSignedOutAsync();
    });

    private Task ReportSignedOutAsync() =>
        Cameras.State == CameraListState.SignedOut ? SignedOut.InvokeAsync() : Task.CompletedTask;

    private string Status(CameraInfo camera)
    {
        if (!camera.Online)
        {
            return L["CameraOffline"];
        }

        var parts = new List<string> { $"{L["CameraOnline"]} · {(camera.Publishing ? L["CameraStreaming"] : L["CameraIdle"])}" };
        if (camera.BatteryLevel is { } battery)
        {
            parts.Add(camera.IsCharging == true ? $"{L["CameraBattery", battery]} ({L["CameraCharging"]})" : L["CameraBattery", battery]);
        }

        if (camera.TemperatureC is { } temperature)
        {
            parts.Add(L["CameraTemperature", Math.Round(temperature)]);
        }

        return string.Join(" · ", parts);
    }
}
