@inherits LayoutComponentBase
@implements IDisposable
@inject IStringLocalizer<Strings> L
@inject StartController Start
@inject CameraListController Cameras
@inject NavigationManager Navigation

<header class="bar">
    <a class="brand" href="">@L["AppTitle"]</a>
    @if (Start.State == StartState.Monitor)
    {
        <nav>
            <NavLink href="" Match="NavLinkMatch.All">@L["NavCameras"]</NavLink>
            <NavLink href="recordings">@L["NavRecordings"]</NavLink>
            <NavLink href="devices">@L["NavDevices"]</NavLink>
            <button class="signout" @onclick="SignOutAsync" disabled="@Start.Busy">@L["SignOut"]</button>
        </nav>
    }
</header>
<main class="content">
    @Body
</main>

@code {
    protected override async Task OnInitializedAsync()
    {
        Start.Changed += OnChanged;
        await Start.EnsureLoadedAsync(CancellationToken.None);
        await ConnectIfMonitorAsync();
    }

    public void Dispose() => Start.Changed -= OnChanged;

    // Leaving starts the app over, so nothing of this Monitor stays in memory.
    private async Task SignOutAsync()
    {
        await Start.SignOutAsync(CancellationToken.None);
        Navigation.NavigateTo("", forceLoad: true);
    }

    // A Monitor keeps its hub connection on every page, so it shows as online and live updates
    // arrive wherever the person is.
    private Task ConnectIfMonitorAsync() =>
        Start.State == StartState.Monitor ? Cameras.StartAsync(CancellationToken.None) : Task.CompletedTask;

    private void OnChanged() => InvokeAsync(async () =>
    {
        StateHasChanged();
        await ConnectIfMonitorAsync();
    });
}
