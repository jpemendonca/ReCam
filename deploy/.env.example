# Copy to deploy/.env and fill in. deploy/.env is not versioned.

# LAN IP of the machine running Docker, e.g. 192.168.0.10.
# Required with compose.bridge.yaml. Optional with compose.yaml (Linux detects it).
RECAM_HOST=

# Comma-separated server URLs placed in pairing QR codes, in order of preference.
# Overrides RECAM_HOST and auto-detection. Example: https://192.168.0.10:8443
RECAM_PUBLIC_URLS=
