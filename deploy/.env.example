# Copy to deploy/.env and fill in. deploy/.env is not versioned.

# Address phones and browsers use to reach the server: the LAN IP at home (e.g. 192.168.0.10), or
# the public IP on a VPS. Required with compose.bridge.yaml and on a VPS. Optional at home on
# Linux with compose.yaml, which detects the LAN IP.
RECAM_HOST=

# Comma-separated server URLs placed in pairing QR codes, in order of preference.
# Overrides RECAM_HOST and auto-detection. Example: https://192.168.0.10:8443
RECAM_PUBLIC_URLS=

# Behind a reverse proxy that terminates TLS (Caddy, Nginx, Traefik): set to off. The server then
# speaks plain HTTP on 8443 and QR codes carry no certificate fingerprint, so the app checks the
# proxy's certificate with the phone's system CAs. Leave empty to keep the server's own HTTPS.
RECAM_TLS=

# Comma-separated IP addresses or networks of the reverse proxies whose X-Forwarded-* headers the
# server believes, e.g. 172.18.0.0/16. Leave empty when there is no proxy.
RECAM_TRUSTED_PROXIES=

# OpenTelemetry collector that receives traces and metrics (OTLP over gRPC). Leave empty to send
# nothing. compose.observability.yaml fills it for Docker Desktop; on Linux with compose.yaml, set
# http://127.0.0.1:4317 to reach the dashboard it starts.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Only with compose.detect.yaml (optional person detection). CPU cores the detect service may use,
# and threads the model runs on. Leave empty for one of each, which keeps the server responsive.
RECAM_DETECT_CPUS=
RECAM_DETECT_THREADS=
